{{!
    @template report_cmcompetency/report

    Moodle template for the course module competency breakdown report table.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * cmid - course module id
    * userid - user id
    * contextid - context id
    * usercompetencies - array of objects containing:
        * competency - object containing:
            * id - competency id
            * shortname - competency shortname
            * idnumber - competency idnumber
        * usercompetencycoursemodule - object containing:
            * userid - user id
            * competencyid - competency id
            * cmid - course module id
            * proficiency - boolean true if proficient
            * grade - object containing:
                * gradename - name of the grade, present when the user competency has been rated

    Example context (json):
    {
        "cmid": 2,
        "userid": 3,
        "contextid": 4,
        "usercompetencies": [
            {
                "competency": {
                    "id": 1,
                    "shortname": "Competency A",
                    "idnumber": "COMPA"
                },
                "usercompetencycoursemodule": {
                    "userid": 3,
                    "competencyid": 1,
                    "cmid": 2,
                    "proficiency": true,
                    "grade": {
                        "gradename": "Competent"
                    }
                }
            }
        ]
    }
}}
<div data-region="competency-breakdown-report" data-cmid="{{cmid}}" data-userid="{{userid}}">
<div class="row">
<div class="col-6">
    <table class="table table-bordered" id="coursemodulecompetencies">
        <caption class="accesshide">
            {{#str}}cmcompetencybreakdownsummary, report_cmcompetency{{/str}}
        </caption>
        <thead>
            <tr>
                <th scope="col">
                    {{#str}}competency, report_competency{{/str}}
                </th>
                <th scope="col">
                    {{#str}}rating, tool_lp{{/str}}
                </th>
            </tr>
        </thead>
        {{#usercompetencies}}
        <tr>
            {{#competency}}
            <td>
                <a href="#" data-action="competency-dialogue" data-id="{{competency.id}}">
                    {{{competency.shortname}}} <em data-id="{{competency.id}}">{{competency.idnumber}}</em>
                </a>
            </td>
            {{/competency}}
            {{#usercompetencycoursemodule}}
            <td class="alert {{#proficiency}}alert-success{{/proficiency}}"
                data-user-competency="true"
                data-userid="{{userid}}"
                data-competencyid="{{competencyid}}"
                data-cmid="{{cmid}}">
                {{> report_cmcompetency/user_competency_summary}}
            </td>
            {{/usercompetencycoursemodule}}
        </tr>
        {{/usercompetencies}}
    </table>
</div>
</div>
</div>
{{#js}}
require(['tool_lp/competencydialogue'], function(Compdialogue) {
    Compdialogue.init();
});
require(['report_cmcompetency/grading_popup_cm'], function(Popup) {
    (new Popup('[data-region=competency-breakdown-report]', '[data-user-competency=true]', '{{contextid}}'));
});
{{/js}}