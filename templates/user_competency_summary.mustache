{{!
    @template report_cmcompetency/user_competency_summary

    Moodle template for a user competency rating summary link in the course module breakdown table.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * grade - object containing:
        * gradename - name of the grade, present when the user competency has been rated

    Example context (json):
    {
        "grade": {
            "gradename": "Competent"
        }
    }
}}
<a href="#" title="{{#str}}usercompetencysummary, report_competency{{/str}}">
    {{#grade}}{{gradename}}{{/grade}}
    {{^grade}}{{#str}}notrated, report_competency{{/str}}{{/grade}}
</a>
