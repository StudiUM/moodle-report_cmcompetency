{{!
    @template report_cmcompetency/user_coursemodule_navigation

    Moodle template for navigating between users when rating competencies in a course module.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * btnbulkrating - html for the bulk rating button
    * groupselector - html for the group selector
    * hasusers - boolean true if there is more than one user
    * previoususerurl - url to the previous user, if any
    * nextuserurl - url to the next user, if any
    * uniqid - unique id used to build element ids
    * users - array of objects containing:
        * id - user id
        * selected - boolean true if this is the currently selected user
        * fullname - user full name
    * baseurl - base url used to build the navigation
    * userid - current user id
    * cmid - course module id

    Example context (json):
    {
        "btnbulkrating": "<button>Rate</button>",
        "groupselector": "",
        "hasusers": true,
        "previoususerurl": "http://example.com/previoususer",
        "nextuserurl": "http://example.com/nextuser",
        "uniqid": "exuniqid",
        "users": [
            {"id": 1, "selected": true, "fullname": "Admin User"},
            {"id": 2, "selected": false, "fullname": "Guest User"}
        ],
        "baseurl": "http://example.com/report",
        "userid": 1,
        "cmid": 2
    }
}}
<div class="float-end border p-2 mb-2">
{{{btnbulkrating}}}
<p>{{{groupselector}}}</p>
<form class="user-competency-course-navigation coursemodule">
{{#hasusers}}
    {{#previoususerurl}}
        <a href="{{{previoususerurl}}}" data-action="previous-user"><i class="fa fa-chevron-circle-left hidden" aria-hidden="true"></i></a>
    {{/previoususerurl}}
    <span>
    <label for="user-nav-{{uniqid}}" class="accesshide">{{#str}}jumptouser, tool_lp{{/str}}</label>
    <select id="user-nav-{{uniqid}}">
        {{#users}}
        <option value="{{id}}" {{#selected}}selected="selected"{{/selected}}>{{fullname}}</option>
        {{/users}}
    </select>
    </span>
    {{#nextuserurl}}
        <a href="{{{nextuserurl}}}" data-action="next-user"><i class="fa fa-chevron-circle-right hidden" aria-hidden="true"></i></a>
    {{/nextuserurl}}
{{/hasusers}}
</form>
</div>
{{#js}}
require(['core/form-autocomplete', 'report_competency/user_course_navigation'], function(autocomplete, nav) {
    (new nav('#user-nav-{{uniqid}}', '#module-nav-{{uniqid}}', '{{baseurl}}', {{userid}}, {{cmid}}));
    {{#hasusers}}
        var enhanced = autocomplete.enhance('#user-nav-{{uniqid}}', false, false, {{# quote }}{{# str }}jumptouser, tool_lp{{/ str }}{{/ quote }});
        return $.when(enhanced)
            .then(function(enhanced) {
                $('[data-action=previous-user] i').removeClass('hidden');
                $('[data-action=next-user] i').removeClass('hidden');
            });
    {{/hasusers}}
});
{{/js}}
